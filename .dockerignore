# ============================================================
# Docker Ignore - Prevent bloat in Docker images
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
*.pyo
*.pyd

# Virtual environments (NEVER include these!)
ragenv/
venv/
.venv/
env/
ENV/
.virtualenv/

# Environment files (secrets!)
.env
.env.*
*.env

# Git
.git/
.gitignore
.gitattributes
.github/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store
*.sublime-*

# Documentation
*.md
README*
docs/
Learning/
examples/
tutorials/

# AWS & Deployment
*.pem
*.key
aws/
terraform/

# Jupyter Notebooks
*.ipynb
.ipynb_checkpoints/
*.ipynb_checkpoints

# Testing
tests/
test_*.py
*_test.py
pytest.ini
.pytest_cache/
.coverage
htmlcov/
.tox/

# Build artifacts
dist/
build/
*.egg-info/
*.egg
.eggs/

# Docker files (don't copy into image!)
docker-compose*.yml
Dockerfile*
.dockerignore

# Logs
*.log
logs/
*.log.*

# Data files (can be large!)
data/
*.csv
*.json
*.parquet
*.xlsx
*.xls
datasets/

# Cache
.cache/
pip-wheel-metadata/
*.sage.py

# OS
Thumbs.db
.DS_Store
desktop.ini

# Backup files
*.bak
*.swp
*~
.backup/

# Temporary files
tmp/
temp/
*.tmp